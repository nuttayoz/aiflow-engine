NODE_ENV=development
LOG_LEVEL=info
API_HOST=0.0.0.0
API_PORT=3000

# Runtime application identity only. Migration credentials use a separate
# environment variable and command in the PostgreSQL foundation slice.
DATABASE_URL=postgresql://aiflow_app:local-application-only@localhost:55439/aiflow
DATABASE_MIGRATION_URL=postgresql://aiflow_migration:local-migration-only@localhost:55439/aiflow
DATABASE_SCHEMA=aiflow
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=10000

RABBITMQ_URL=amqp://aiflow_app:local-rabbitmq-only@localhost:55672/aiflow
RABBITMQ_PREFETCH=10
RABBITMQ_CONNECTION_TIMEOUT_MS=5000

S3_BUCKET=aiflow-local
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:55674
S3_FORCE_PATH_STYLE=true
S3_ENCRYPTION_MODE=AES256
S3_ALLOW_CHECKSUM_METADATA_FALLBACK=true
S3_REQUEST_TIMEOUT_MS=30000
# Local Moto credentials only. Production uses the workload IAM role.
AWS_ACCESS_KEY_ID=local-moto-only
AWS_SECRET_ACCESS_KEY=local-moto-only

# Local-only root material. Production injects versioned key material from the
# approved secret manager and uses the public HTTPS callback URL.
SHAREPOINT_ROOT_KEY_BASE64=YWlmbG93LWxvY2FsLXNoYXJlcG9pbnQtcm9vdC1rZXktMQ==
SHAREPOINT_KEY_VERSION=1
SHAREPOINT_CALLBACK_URL=http://localhost:3000/provider-callbacks/v1/microsoft-graph/sharepoint
SHAREPOINT_GRAPH_MODE=FAKE
SHAREPOINT_GRAPH_REQUEST_TIMEOUT_MS=30000
SHAREPOINT_DOWNLOAD_HOST_SUFFIXES=.sharepoint.com,.1drv.com
SHAREPOINT_CONSENT_REDIRECT_ORIGINS=http://localhost:3001

METRICS_ENABLED=true
METRICS_HOST=0.0.0.0
# Defaults: API 9464, worker 9465, scheduler 9466. Set only when one role runs.
# METRICS_PORT=9464
# Existing platform Sentry project DSN; leave unset locally.
# SENTRY_DSN=https://public-key@sentry.example/project-id
