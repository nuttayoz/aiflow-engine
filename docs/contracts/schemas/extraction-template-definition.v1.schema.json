{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiflow-engine:schema:extraction-template-definition:v1",
  "title": "AiFlow Custom Extraction Template Definition v1",
  "description": "Provider-neutral authoring definition compiled into one immutable custom extraction-profile version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sections"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sectionKey",
        "documentType",
        "fields",
        "tableColumns",
        "additionalInstructions"
      ],
      "properties": {
        "sectionKey": {
          "$ref": "#/$defs/outputKey"
        },
        "documentType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "fields": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "tableColumns": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/tableColumn"
          }
        },
        "additionalInstructions": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "anyOf": [
        {
          "properties": {
            "fields": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "tableColumns": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceHint", "outputKey", "scope", "required"],
      "properties": {
        "sourceHint": {
          "$ref": "#/$defs/sourceHint"
        },
        "outputKey": {
          "$ref": "#/$defs/outputKey"
        },
        "scope": {
          "enum": ["PAGE", "DOCUMENT"]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "tableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceHint", "outputKey", "required"],
      "properties": {
        "sourceHint": {
          "$ref": "#/$defs/sourceHint"
        },
        "outputKey": {
          "$ref": "#/$defs/outputKey"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "sourceHint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "outputKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    }
  }
}
